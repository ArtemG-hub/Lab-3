import tkinter as tk  #для создания графического интерфейса
from tkinter import messagebox   #для вызова всплывающих окон с предупреждениями
import random 
import winsound #для работы со звуком в Windows
import wave     #для создания и записи аудиофайлов формата WAV

def play_music():
    data = bytearray() #создаем пустой массив байт для записи звуковых данных с bytearray
    for note in [262, 330, 392, 523]: #проходим по частотам нот из списка
        for i in range(6000): 
            if (i * note * 2 // 20050) % 2 == 0:   #формула генерирует прямоугольную звуковую волну (генерация звука "по байтам")
                data.append(130)
            else:
                data.append(126) 
                
    f = wave.open('melody.wav', 'wb') #открываем файл 'melody.wav' для записи в бинарном режиме ('wb')
    f.setnchannels(1)      #устанавливаем 1 канал (моно-звук)
    f.setsampwidth(1)      #устанавливаем размер сэмпла — 1 байт (8 бит)
    f.setframerate(22050)  #устанавливаем частоту дискретизации (22050 Гц — качество звука)
    f.writeframes(bytes(data)) #записываем сгенерированные байты звука в файл
    f.close()
    
    winsound.PlaySound('melody.wav', winsound.SND_FILENAME | winsound.SND_ASYNC | winsound.SND_LOOP) #запускаем бесконечное (SND_LOOP) и асинхронное без зависания программывоспроизведение файла

step = 0
def animate_ui():
    colors = ["gold", "lime", "aqua", "silver"] #список цветов для мигания элементов
    global step              #объявляем, что используем глобальную переменную step
    index = step % len(colors) #находим индекс цвета через остаток от деления, чтобы циклично ходить по списку
    word_label.config(fg=colors[index]) #меняем цвет текста (fg - foreground) у главного заголовка
    btn_generate.config(bg=colors[index]) #меняем цвет фона (bg - background) у кнопки генерации
    step += 1                     #увеличиваем шаг для следующего цвета
    window.after(500, animate_ui) #рекурсивно вызываем эту же функцию через каждые 500 миллисекунд (создаем таймер)

def cancel():
