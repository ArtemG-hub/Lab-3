used_letters_label = tk.Label(window, text='Log:')              #создаем текстовое поле (Log) для вывода готового ключа

used_letters_label.place(relx=0.5, rely=0.9, anchor='center')   #размещаем по центру экрана снизу (anchor='center' выравнивает элемент ровно по его собственной середине)

