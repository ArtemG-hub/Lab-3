def generate_key():
    user_input = number_entry.get() #получаем текст, который пользователь ввел в текстовое поле entry

    if user_input.isdigit() == False or len(value:=user_input) != 6:    
        tk.messagebox.showwarning('Неверный ввод!', 'Нужно ввести 6 цифр!')
        return 0 #выходим из функции, прекращая генерацию
        
    part_1=user_input[0:3] #берем срез строки: первые 3 цифры (индексы 0, 1, 2)
    part_2=user_input[3:6] #берем срез строки: последние 3 цифры (индексы 3, 4, 5)
    list_1 = list(part_2)  #превращаем вторую часть в список символов, чтобы его можно было перемешать
    list_2 = list(part_1)  #превращаем первую часть в список символов
    random.shuffle(list_1) #случайным образом перемешиваем элементы внутри списка list_1
    random.shuffle(list_2) #случайным образом перемешиваем элементы внутри списка list_2
    
    letters = "QWERTYUIOPASDFGHJKLZXCVBNM" #строка со всеми доступными английскими буквами
    block_1 = "".join(list_1) + random.choice(letters) + random.choice(letters) #собираем блок 1: склеиваем перемешанные цифры ("".join) и добавляем 2 случайные буквы
    block_2 = "".join(list_2) + random.choice(letters) + random.choice(letters) #собираем блок 2: склеиваем перемешанные цифры и добавляем 2 случайные буквы
    block_3 = int(part_1)+int(part_2)      #вычисляем блок 3: переводим строки в числа и складываем их математически
    
    
    final_list = f"{block_1}-{block_2} {block_3:04d}"     #форматируем финальную строку, подставляем блоки, ":04d" означает вывести число минимум из 4 цифр (добавит нули слева, если число маленькое)
    used_letters_label.config(text=f"Ключ: {final_list}") #выводим сгенерированный ключ на экран в текстовую метку log

