import tkinter as tk
from tkinter import messagebox
import random
import winsound
import wave


def play_music():
    data = bytearray()
    for note in [262, 330, 392, 523]:       
        for i in range(6000):               
            if (i * note * 2 // 20000) % 2 == 0:
                data.append(130)
            else:
                data.append(126)
    f = wave.open('melody.wav', 'wb')
    f.setnchannels(1)
    f.setsampwidth(1)
    f.setframerate(22050)
    f.writeframes(bytes(data))
    f.close()
    winsound.PlaySound('melody.wav', winsound.SND_FILENAME | winsound.SND_ASYNC | winsound.SND_LOOP)


step = 0
def animate_ui():
    colors = ["gold", "lime", "aqua", "silver"]
    global step
    idx = step % len(colors)
    word_label.config(fg=colors[idx])
    btn_generate.config(bg=colors[idx])
    step += 1
    window.after(400, animate_ui)


def cancel():
    window.destroy()

def generate_key():
    user_input = number_entry.get()
    if user_input.isdigit() == False or len(user_input) != 6:
        tk.messagebox.showwarning('Неверный ввод!', 'Нужно ввести 6 цифр!')
        return 0
    part_1=user_input[0:3]
    part_2=user_input[3:6]
    list_1 = list(part_2)
    list_2=list(part_1)
    random.shuffle(list_1)
    random.shuffle(list_2)
    letters = "QWERTYUIOPASDFGHJKLZXCVBNM"
    block_1 = "".join(list_1) + random.choice(letters) + random.choice(letters)
    block_2 = "".join(list_2) + random.choice(letters) + random.choice(letters)
    block_3 = int(part_1)+int(part_2)
    final_list = f"{block_1}-{block_2} {block_3:04d}"
    used_letters_label.config(text=f"Ключ: {final_list}")


window = tk.Tk()
window.title('My app')
window.geometry('800x460')
bg_img = tk.PhotoImage(file='image.png')

label_bg = tk.Label(window, image=bg_img)
label_bg.place(x=0, y=0, 
               relwidth=1, 
               relheight=1)

word_label = tk.Label(window, 
                      text='генератор кода', 
                      font=('Consolas', 40), 
                      bg='purple', fg='white')
word_label.place(x=0, y=0, relwidth=1)

letter_label = tk.Label(window, 
                        text='Введите 6 цифр:', 
                        font=('Verdana', 14))
letter_label.place(relx=0.07, rely=0.35)
number_entry = tk.Entry(window, width=6, font=('Verdana', 16))
number_entry.insert(0, '')
number_entry.place(relx=0.8, rely=0.35)


btn_cancel = tk.Button(window, text='Cancel', width=15, command=cancel)
btn_cancel.place(relx=0.44, rely=0.7)

btn_generate = tk.Button(window, text ='Generate', width=15, command=generate_key)
btn_generate.place(relx=0.44, rely=0.6)


used_letters_label = tk.Label(window, text='Log:')
used_letters_label.place(relx=0.5, rely=0.9, anchor='center')


play_music()
animate_ui()
window.mainloop()
